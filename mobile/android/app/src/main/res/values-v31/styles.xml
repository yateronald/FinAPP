<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ takes over the launch screen: it ignores windowBackground and
     draws the app icon on windowSplashScreenBackground. The icon is masked to
     a circle, so only the symbol can live here — the "Fynexa" wordmark appears
     immediately afterwards on the Flutter splash.

     Kept white in both light and dark so the hand-over to the Flutter splash
     (also light) shows no colour jump. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">#FFFFFF</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
