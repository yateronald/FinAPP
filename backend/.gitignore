# Dependencies
node_modules/

# Build output
dist/
build/
# Incremental-compilation cache (tsconfig "incremental": true). Machine-local
# and stale the moment anyone else builds — committing it causes phantom diffs.
*.tsbuildinfo

# Environment
.env
.env.local
.env.*.local

# Logs
logs/
*.log
npm-debug.log*

# Coverage
coverage/
.nyc_output/

# IDE
.vscode/
.idea/
*.swp
.DS_Store

# Prisma
prisma/*.db
prisma/*.db-journal

# Misc
.cache/
tmp/

# Firebase service account (secret - never commit)
serviceAccount.json
firebase-service-account*.json
