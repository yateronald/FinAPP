# ==========================================================================
# FinApp Backend - Environment Variables
# Copy this file to `.env` and fill in the real values. NEVER commit `.env`.
# ==========================================================================

# --- Application ---
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
# Comma-separated list of allowed origins for CORS (web + mobile dev)
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# --- Database (Aiven PostgreSQL) ---
# Example: postgres://USER:PASSWORD@HOST:PORT/DB?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/finapp?schema=public

# --- JWT / Auth ---
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN_MOBILE=180d
# Cookie settings for web refresh token
COOKIE_SECRET=change_me_cookie_secret_min_32_chars

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# --- Google Gemini AI ---
# Primary key + optional fallbacks. On quota/error the client rotates through
# GEMINI_API_KEY, then GEMINI_API_KEY1, GEMINI_API_KEY2 ... GEMINI_API_KEY9.
# Keys starting with "AIza" use API-key auth; anything else uses Bearer (OAuth) auth.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_API_KEY1=your_gemini_fallback_api_key
# GEMINI_API_KEY2=
# GEMINI_API_KEY3=
GEMINI_MODEL=gemini-3.5-flash
# GEMINI_MODEL=gemini-3-flash-preview

# --- Email (SMTP) for OTP / password reset ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
MAIL_FROM_NAME=FinApp
MAIL_FROM_ADDRESS=no-reply@finapp.local

# --- OTP ---
OTP_EXPIRES_MINUTES=10

# --- Email verification at sign-up ---
# Leave unset to follow SMTP: verification is enforced only when a real mail
# server is configured, so unconfigured environments don't lock new accounts
# out behind a code nobody can receive. Set true/false to force it.
# AUTH_REQUIRE_EMAIL_VERIFICATION=true

# --- Rate limiting ---
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# --- Frontend URL (for links in emails) ---
WEB_APP_URL=http://localhost:3000

# --- Default currency ---
DEFAULT_CURRENCY=XOF

AGENTROUTER_API_KEY=your_agentrouter_key
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
AGENTROUTER_MODEL=claude-opus-4-8

# --- Firebase Cloud Messaging (push notifications) ---
# REQUIRED to send push. Download from Firebase Console → Project Settings →
# Service accounts → "Generate new private key". Provide it here as either the
# raw JSON on one line, OR base64-encoded (recommended, avoids quoting issues):
#   base64:  cat serviceAccount.json | base64 -w0
# FIREBASE_SERVICE_ACCOUNT=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50Ii...
# Alternatively, point to a JSON file path (application default credentials):
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccount.json
